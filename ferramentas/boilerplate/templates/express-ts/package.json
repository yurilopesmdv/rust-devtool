{
  "name": "{{PROJECT_NAME}}",
  "version": "0.1.0",
  "private": true,
  "type": "{{PACKAGE_TYPE}}",
  "engines": {
    "node": "{{NODE_ENGINE}}"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint .",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "express": "5.3.0",
    "cors": "2.8.6"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "@types/express": "5.0.6",
    "@types/cors": "2.8.19",
    "dprint": "0.64.3",
    "@dprint/typescript": "0.96.1",
    "eslint": "10.13.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.0",
    "globals": "17.13.0"
  }
}
