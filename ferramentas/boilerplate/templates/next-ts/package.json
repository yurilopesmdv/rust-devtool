{
  "name": "{{PROJECT_NAME}}",
  "version": "0.1.0",
  "private": true,
  "type": "{{PACKAGE_TYPE}}",
  "engines": {
    "node": "{{NODE_ENGINE}}"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3001",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3001",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.tsx",
    "lint": "eslint .",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "dprint": "0.64.3",
    "@dprint/typescript": "0.96.1",
    "eslint": "10.13.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.0",
    "globals": "17.13.0"
  }
}
