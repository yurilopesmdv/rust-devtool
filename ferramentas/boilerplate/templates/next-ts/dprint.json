{
  "lineWidth": 100,
  "indentWidth": 2,
  "typescript": {
    "quoteStyle": "preferSingle"
  },
  "includes": [
    "**/*.{ts,tsx,js,mjs,cjs,jsx}"
  ],
  "excludes": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/build/**",
    "**/coverage/**"
  ],
  "plugins": [
    "./node_modules/@dprint/typescript/plugin.wasm"
  ]
}
